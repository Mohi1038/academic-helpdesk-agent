# Copy to .env and adjust.

# Ollama endpoint: a local install, or the remote server through scripts/tunnel.sh
OLLAMA_API_BASE=http://localhost:11434
CHAT_MODEL=qwen3:8b
EMBED_MODEL=nomic-embed-text

# Evaluation judge (Anthropic API)
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-5-5
JUDGE_EFFORT=medium
